# LLM model and credentials are deployment-wide. Stored credentials and
# protocol preferences are per account; environment values override or fall
# back to stored ones.
LLM_MODEL=gpt-4o
LLM_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
LLM_KEY=sk-1234
SEARXNG_URL=http://localhost:8081
SHOW_TOOLCALLS=false

# Required. Standard base64 encoding of exactly 32 random bytes. Generate once
# with `openssl rand -base64 32`, then store the value here or in a secret
# manager. Keep the real key outside the database, restrict the environment
# file to 0600, and back the key up separately. Losing or changing it makes
# existing encrypted data unreadable. The app never generates a key silently.
KRITUI_ENCRYPTION_KEY=

# Session cookies default to Secure for production HTTPS, including behind a
# TLS-terminating reverse proxy. Set false only for direct local HTTP such as
# http://localhost:8080.
KRITUI_SECURE_COOKIES=true
