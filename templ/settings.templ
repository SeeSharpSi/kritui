package templates

import (
	"slices"
	"strconv"

	kritui_db "seesharpsi/kritui/db"
)

// SettingsPanelData groups every input the settings panel renders, including
// the out-of-band appends picker refresh that follows a successful save.
type SettingsPanelData struct {
	ChatID           string
	Models           []string
	SelectedModel    string
	MaxToolRounds    int
	ToolNames        []string
	DefaultTools     []string
	PromptAppends    []kritui_db.PromptAppend
	NtfySettings     kritui_db.NtfySettings
	ClearNtfyAPIKey  bool
	Saved            bool
	Visible          bool
	ErrorMessage     string
	EnabledAppendIDs []string
}

templ SettingsPage(data SettingsPanelData) {
	<section
		id="settings-page"
		class="panel-page settings-page"
		aria-labelledby="settings-heading"
		if !data.Visible {
			hidden
		}
	>
		<header class="panel-heading">
			<h1 id="settings-heading" tabindex="-1" data-panel-initial-focus>Settings</h1>
			<p>Conversation defaults and app notifications.</p>
		</header>
		<form
			class="settings-main-form"
			action={ "/settings?chat=" + data.ChatID }
			method="post"
			hx-post={ "/settings?chat=" + data.ChatID }
			hx-target="#settings-page"
			hx-swap="outerHTML"
		>
			<input type="hidden" name="append_form" value="1"/>
			<input type="hidden" name="ntfy_form" value="1"/>
			if data.Saved {
				<p class="settings-status" role="status" data-settings-saved>Settings saved.</p>
			}
			if data.ErrorMessage != "" {
				<p class="settings-status settings-error" role="alert">{ data.ErrorMessage }</p>
			}
			<section class="settings-section" aria-labelledby="chat-defaults-heading">
				<header class="settings-section-heading">
					<span class="settings-section-label">01 / Chat</span>
					<h2 id="chat-defaults-heading">Chat defaults</h2>
					<p>Starting point for every new conversation.</p>
				</header>
				<div class="settings-fields">
					<div class="settings-field">
						<div class="settings-field-copy">
							<label for="default-model">Default model</label>
							<p class="settings-help">Preselected for each new chat.</p>
						</div>
						<div class="settings-control">
							<select id="default-model" name="model" required>
								for _, model := range data.Models {
								<option value={ model } if model == data.SelectedModel { selected }>{ model }</option>
								}
							</select>
						</div>
					</div>
					<div class="settings-field">
						<div class="settings-field-copy">
							<label for="max-tool-rounds">Max tool-call rounds</label>
							<p class="settings-help">Tool-call chains per response.</p>
						</div>
						<div class="settings-control">
							<input id="max-tool-rounds" type="number" name="max_tool_rounds" value={ strconv.Itoa(data.MaxToolRounds) } min="1" max="100" required/>
						</div>
					</div>
					<div class="settings-field">
						<div class="settings-field-copy">
							<h3 id="default-tools-heading">Default tools</h3>
							<p class="settings-help">Preselected for each new chat. Select any combination.</p>
						</div>
						<div class="settings-tool-control">
							<div class="settings-tool-options" role="group" aria-labelledby="default-tools-heading">
								for _, tool := range data.ToolNames {
									<label class="settings-tool-option">
										<input type="checkbox" role="switch" name="default_tool" value={ tool } if slices.Contains(data.DefaultTools, tool) { checked }/>
										<span>{ tool }</span>
									</label>
								}
							</div>
						</div>
					</div>
				</div>
			</section>
			<section class="settings-section" aria-labelledby="prompt-appends-heading">
				<header class="settings-section-heading">
					<span class="settings-section-label">02 / Prompts</span>
					<h2 id="prompt-appends-heading">Prompt appends</h2>
					<p>Presets appear in chat options; selected text is added to messages.</p>
				</header>
				<div class="settings-append-list">
					for _, preset := range data.PromptAppends {
						<fieldset class="settings-append">
							<legend>{ preset.Name }</legend>
							<input type="hidden" name="append_id" value={ preset.ID }/>
							<label class="settings-append-default">
								<input type="checkbox" role="switch" name="default_append" value={ preset.ID } if preset.EnabledByDefault { checked }/>
								<span>Enable for new chats</span>
							</label>
							<div class="settings-append-field">
								<label for={ "append-name-" + preset.ID }>Name</label>
								<input id={ "append-name-" + preset.ID } type="text" name={ "append_name_" + preset.ID } value={ preset.Name } maxlength="80" required/>
							</div>
							<div class="settings-append-field">
								<label for={ "append-text-" + preset.ID }>Text</label>
								<textarea id={ "append-text-" + preset.ID } name={ "append_text_" + preset.ID } rows="3" required>{ preset.Text }</textarea>
							</div>
							<button class="settings-remove" type="submit" name="remove_append" value={ preset.ID } formnovalidate>Remove</button>
						</fieldset>
					}
				</div>
				<div class="settings-append-actions">
					<button class="settings-add" type="submit" name="append_action" value="add" formnovalidate>Add append</button>
				</div>
			</section>
			<section id="ntfy-settings" class="settings-section" aria-labelledby="ntfy-settings-heading">
				<header class="settings-section-heading">
					<span class="settings-section-label">03 / Delivery</span>
					<h2 id="ntfy-settings-heading">Notifications</h2>
					<p>Send notification when response completes. Leave endpoint and topic empty to disable.</p>
				</header>
				<div class="settings-fields">
					<div class="settings-field">
						<div class="settings-field-copy">
							<label for="ntfy-endpoint">Endpoint</label>
							<p class="settings-help">Base URL, for example https://ntfy.sh.</p>
						</div>
						<div class="settings-control">
							<input id="ntfy-endpoint" type="url" name="ntfy_endpoint" value={ data.NtfySettings.Endpoint } maxlength="2048"/>
						</div>
					</div>
					<div class="settings-field">
						<div class="settings-field-copy">
							<label for="ntfy-topic">Topic</label>
							<p class="settings-help">Letters, numbers, hyphens, and underscores; maximum 64 characters.</p>
						</div>
						<div class="settings-control">
							<input id="ntfy-topic" type="text" name="ntfy_topic" value={ data.NtfySettings.Topic } maxlength="64" pattern="[A-Za-z0-9_\-]{1,64}"/>
						</div>
					</div>
					<div class="settings-field">
						<div class="settings-field-copy">
							<label for="ntfy-api-key">API key</label>
							<p class="settings-help">Stored on server. Never shown here. Blank preserves existing key.</p>
						</div>
						<div class="settings-control settings-control-column">
							<input
								id="ntfy-api-key"
								type="password"
								name="ntfy_api_key"
								autocomplete="new-password"
								hx-preserve="true"
								if data.ClearNtfyAPIKey {
									disabled
								}
							/>
							if data.NtfySettings.APIKeyConfigured {
								<input id="clear-ntfy-api-key" type="checkbox" name="clear_ntfy_api_key" value="1" hidden if data.ClearNtfyAPIKey { checked }/>
								<button class="settings-clear-key" type="button" data-settings-clear-open if data.ClearNtfyAPIKey { hidden }>Clear stored key</button>
								<p class="settings-clear-pending" data-settings-clear-pending role="status" if !data.ClearNtfyAPIKey { hidden }>API key will be removed when settings are saved. <button type="button" data-settings-clear-undo>Undo</button></p>
							}
						</div>
					</div>
				</div>
				<dialog class="settings-dialog" data-settings-clear-dialog aria-labelledby="settings-clear-title">
					<h2 id="settings-clear-title">Clear stored API key?</h2>
					<p>This removes saved notification credentials when you save settings.</p>
					<div class="settings-dialog-actions">
						<button type="button" data-settings-clear-cancel>Cancel</button>
						<button class="settings-dialog-danger" type="button" data-settings-clear-confirm>Clear key</button>
					</div>
				</dialog>
			</section>
			<div class="settings-save-bar">
				<span>All changes save together.</span>
				<button class="settings-save" type="submit">Save settings</button>
			</div>
		</form>
	</section>
}

templ SettingsButton() {
	<button
		id="settings-button"
		type="button"
		class="settings-button"
		data-panel-target="settings-page"
		aria-controls="settings-page"
		aria-label="Settings"
		title="Settings"
		aria-expanded="false"
	>
		@Icon(
			"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37a1.724 1.724 0 0 0 2.572-1.065z",
			"M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0",
		)
	</button>
}
