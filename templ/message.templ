package templates

import (
	"encoding/base64"
	"fmt"
	"strconv"
	"strings"

	kritui_db "seesharpsi/kritui/db"
	"seesharpsi/kritui/llm"
	"seesharpsi/kritui/markdown"
)

func isPDFAttachment(attachment llm.UserAttachment) bool {
	return attachment.MediaType == "application/pdf"
}

func userAttachmentDataURL(attachment llm.UserAttachment) templ.SafeURL {
	switch attachment.MediaType {
	case "image/png", "image/jpeg", "image/webp":
		return templ.SafeURL("data:" + attachment.MediaType + ";base64," + base64.StdEncoding.EncodeToString(attachment.Data))
	default:
		return templ.SafeURL("")
	}
}

func userAttachmentLabel(attachment llm.UserAttachment) string {
	if attachment.Filename != "" {
		return attachment.Filename
	}
	if isPDFAttachment(attachment) {
		return "Attached PDF"
	}
	return "Attached image"
}

// MessageAttachmentURL returns the authenticated URL for one message attachment.
func MessageAttachmentURL(chatID string, messageID int64, index int) string {
	return "/chats/" + chatID + "/messages/" + strconv.FormatInt(messageID, 10) + "/attachments/" + strconv.Itoa(index)
}

func messageHasPDF(attachments []llm.UserAttachment) bool {
	for _, attachment := range attachments {
		if isPDFAttachment(attachment) {
			return true
		}
	}
	return false
}

func messageEditErrorID(messageID int64) string {
	return "message-edit-error-" + strconv.FormatInt(messageID, 10)
}

func messageModelMeta(message llm.Message) string {
	var parts []string
	if message.TotalTokens != nil {
		parts = append(parts, fmt.Sprintf("%d tokens", *message.TotalTokens))
	}
	if message.Cost != nil {
		parts = append(parts, formatMessageCost(*message.Cost, message.CostEstimated))
	}
	return strings.Join(parts, " · ")
}

func formatMessageCost(cost float64, estimated bool) string {
	formatted := fmt.Sprintf("$%.4f", cost)
	if cost > 0 && cost < 0.00005 {
		formatted = "<$0.0001"
	}
	if estimated {
		return "~" + formatted
	}
	return formatted
}

// toolCallArgsBody is args without trailing `}` so CSS can ellipsis then keep `}`.
func toolCallArgsBody(args string) string {
	return strings.TrimSuffix(args, "}")
}

// toolCallElisionTitle describes a name whose tool result was reduced from the
// model context without changing the stored result text.
func toolCallElisionTitle(call llm.ToolCall) string {
	if call.ResultElided {
		return "Tool result elided from model context"
	}
	return ""
}

// messageView is one UI block: combined tool-call rounds and/or a visible message.
type messageView struct {
	ToolCalls  []llm.ToolCall
	ToolErrors map[string]string
	Message    *llm.Message
}

// messagesForView merges consecutive assistant tool-call rounds into one group,
// matching the live completion tracker. Tool role messages stay hidden. Usage
// from those rounds is summed onto the following final assistant message.
func messagesForView(messages []llm.Message) []messageView {
	var views []messageView
	var pending []llm.ToolCall
	var pendingErrors map[string]string
	var totalTokens *int
	var cost *float64
	costEstimated := false
	flush := func() {
		if len(pending) == 0 {
			pendingErrors = nil
			return
		}
		views = append(views, messageView{ToolCalls: pending, ToolErrors: pendingErrors})
		pending = nil
		pendingErrors = nil
	}
	addUsage := func(message *llm.Message) {
		if message.Role != "assistant" {
			return
		}
		if message.TotalTokens != nil {
			if totalTokens == nil {
				totalTokens = new(int)
			}
			*totalTokens += *message.TotalTokens
		}
		if message.Cost != nil {
			if cost == nil {
				cost = new(float64)
			}
			*cost += *message.Cost
		}
		if message.CostEstimated {
			costEstimated = true
		}
	}
	for i := range messages {
		message := &messages[i]
		switch {
		case message.Role == "tool":
			if toolError := llm.ToolErrorMessage(message.Content); toolError != "" {
				if pendingErrors == nil {
					pendingErrors = make(map[string]string)
				}
				pendingErrors[message.ToolCallID] = toolError
			}
			continue
		case message.Role == "assistant" && len(message.ToolCalls) > 0:
			addUsage(message)
			pending = append(pending, message.ToolCalls...)
		case message.Role == "assistant":
			addUsage(message)
			flush()
			view := *message
			view.TotalTokens = totalTokens
			view.Cost = cost
			view.CostEstimated = costEstimated
			views = append(views, messageView{Message: &view})
			totalTokens = nil
			cost = nil
			costEstimated = false
		default:
			flush()
			views = append(views, messageView{Message: message})
		}
	}
	flush()
	return views
}

templ Messages(chatID string, messages ...llm.Message) {
	for _, view := range messagesForView(messages) {
		@CompletedToolCalls(view.ToolCalls, view.ToolErrors)
		if view.Message != nil {
			if view.Message.Role == "user" {
				@UserMessage(chatID, *view.Message)
			} else {
				<article class="message">
					if view.Message.Role == "assistant" {
						<strong>{ view.Message.Model }</strong>
						if meta := messageModelMeta(*view.Message); meta != "" {
							<span class="message-meta"> · { meta }</span>
						}
						<div class="message-content markdown">
							@markdown.Render(view.Message.Content)
						</div>
						if view.Message.ID > 0 && chatID != "" && len(view.Message.ToolCalls) == 0 {
							@MessageShareActions(chatID, view.Message.ID, view.Message.Content, "")
						}
					} else {
						<div class="message-content plain-text">{ view.Message.Content }</div>
					}
				</article>
			}
		}
	}
}

templ UserMessage(chatID string, message llm.Message) {
	<article class="message user" id={ "message-" + strconv.FormatInt(message.ID, 10) }>
		if len(message.Attachments) > 0 {
			<div class={ "message-images", "message-attachments", templ.KV("attachments-static", messageHasPDF(message.Attachments)) } aria-label="Attached files">
				for index, attachment := range message.Attachments {
					if isPDFAttachment(attachment) {
						if message.ID > 0 && chatID != "" {
							<a
								class="message-attachment-pdf"
								title={ userAttachmentLabel(attachment) }
								href={ MessageAttachmentURL(chatID, message.ID, index) }
								target="_blank"
								rel="noopener"
								aria-label={ "Open " + userAttachmentLabel(attachment) + " in a new tab" }
							>
								<span class="message-attachment-pdf-label">PDF</span>
								<span class="message-attachment-pdf-name">{ userAttachmentLabel(attachment) }</span>
							</a>
						} else {
							<div class="message-attachment-pdf" title={ userAttachmentLabel(attachment) }>
								<span class="message-attachment-pdf-label">PDF</span>
								<span class="message-attachment-pdf-name">{ userAttachmentLabel(attachment) }</span>
							</div>
						}
					} else if src := userAttachmentDataURL(attachment); src != "" {
						<img
							class="message-image"
							src={ src }
							alt={ userAttachmentLabel(attachment) }
							title={ userAttachmentLabel(attachment) }
							loading="lazy"
							decoding="async"
							role="button"
							tabindex="0"
							data-image-viewer
							aria-haspopup="dialog"
							aria-controls="image-viewer"
							aria-label={ "Open " + userAttachmentLabel(attachment) }
						/>
					}
				}
			</div>
		}
		<div class="message-bubble">
			<div class="message-content plain-text">{ message.Content }</div>
			if message.ID > 0 && chatID != "" {
				<form
					id={ "message-edit-form-" + strconv.FormatInt(message.ID, 10) }
					class="message-edit-form"
					hx-put={ "/chats/" + chatID + "/messages/" + strconv.FormatInt(message.ID, 10) }
					hx-target={ "#" + messageEditErrorID(message.ID) }
					hx-swap="outerHTML"
					hx-sync="#messages:drop"
					hx-disable="find input"
					hx-include="[form='message-form'][name='model']:checked, [form='message-form'][name='tool']:checked, [form='message-form'][name='append']:checked"
				>
					<label class="visually-hidden" for={ "message-edit-input-" + strconv.FormatInt(message.ID, 10) }>Edit message</label>
					<input
						id={ "message-edit-input-" + strconv.FormatInt(message.ID, 10) }
						class="message-edit-input"
						type="text"
						name="message"
						value={ message.Content }
						required
						autocomplete="off"
					/>
					@MessageEditError(message.ID, "")
				</form>
			}
		</div>
		<div class="message-below">
			<div class="message-actions">
				@MessageAppendTexts(message.PromptAppendTexts)
				<div class="message-action-buttons">
					if message.ID > 0 && chatID != "" {
						<button
							type="button"
							class="message-edit-toggle"
							aria-controls={ "message-edit-input-" + strconv.FormatInt(message.ID, 10) }
							aria-expanded="false"
							aria-label="Edit message"
							title="Edit message"
						>
							@Icon("M12 20h9", "M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z")
						</button>
						<button
							type="button"
							class="message-copy-button"
							aria-label="Copy message"
							title="Copy message"
						>
							<span class="message-copy-default">
								@Icon("M9 9h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-9a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z", "M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1")
							</span>
							<span class="message-copy-confirmation">
								@Icon("M20 6 9 17l-5-5")
							</span>
						</button>
						<button
							type="submit"
							class="message-edit-save"
							form={ "message-edit-form-" + strconv.FormatInt(message.ID, 10) }
							aria-label="Save message edit"
							title="Save message edit"
						>
							@Icon("M20 6 9 17l-5-5")
						</button>
						<button
							type="button"
							class="message-edit-cancel"
							aria-label="Cancel message edit"
							title="Cancel message edit"
						>
							@Icon("M18 6 6 18", "m6 6 12 12")
						</button>
					}
				</div>
			</div>
		</div>
	</article>
}

templ MessageEditError(messageID int64, message string) {
	<p
		id={ messageEditErrorID(messageID) }
		class="message-edit-error"
		role="alert"
		if message == "" {
			hidden
		}
	>{ message }</p>
}

templ MessageAppendTexts(texts []string) {
	if len(texts) > 0 {
		<details class="message-appends">
			<summary>appends</summary>
			<div class="message-appends-content">
				for _, text := range texts {
					<div class="message-append">{ text }</div>
				}
			</div>
		</details>
	}
}

templ ToolCalls(calls []llm.ToolCall, runningID string, toolErrors map[string]string) {
	@toolCalls(calls, runningID, toolErrors)
}

templ toolCalls(calls []llm.ToolCall, runningID string, toolErrors map[string]string) {
	for _, call := range calls {
		<div class={ "tool-call", templ.KV("loading", call.ID == runningID), templ.KV("tool-error", toolErrors[call.ID] != ""), templ.KV("tool-elided", call.ResultElided) } data-tool-call-id={ call.ID } role="listitem">
			if call.ID == runningID {
				<span class="braille-spinner" aria-hidden="true"></span>
				<span class="visually-hidden">Running tool: </span>
			} else {
				<span class="tool-call-complete" aria-hidden="true"></span>
				if toolErrors[call.ID] != "" {
					<span class="visually-hidden">Failed tool: </span>
				} else {
					<span class="visually-hidden">Completed tool: </span>
				}
			}
			if call.Function.Arguments != "" && call.Function.Arguments != "{}" || toolErrors[call.ID] != "" {
				<button
					type="button"
					class="tool-call-toggle"
					aria-expanded="false"
					title={ toolCallElisionTitle(call) }
				>{ call.Function.Name }</button>
				if call.Function.Arguments == "{}" {
					<code>{ call.Function.Arguments }</code>
				} else if strings.HasSuffix(call.Function.Arguments, "}") {
					<code><span>{ toolCallArgsBody(call.Function.Arguments) }</span>{ "}" }</code>
				} else if call.Function.Arguments != "" {
					<code><span>{ call.Function.Arguments }</span></code>
				}
				if toolErrors[call.ID] != "" {
					<div class="tool-call-error" role="alert">{ toolErrors[call.ID] }</div>
				}
			} else {
				<strong title={ toolCallElisionTitle(call) }>{ call.Function.Name }</strong>
			}
		</div>
	}
}

templ CompletedToolCalls(calls []llm.ToolCall, toolErrors map[string]string) {
	if len(calls) > 0 {
		<details class="completed-tool-calls">
			<summary>
				if len(calls) == 1 {
					1 tool call used
				} else {
					{ fmt.Sprintf("%d tool calls used", len(calls)) }
				}
			</summary>
			<div class="tool-call-list" role="list">
				@toolCalls(calls, "", toolErrors)
			</div>
		</details>
	}
}

templ CompletedMessage(chatID string, messages ...llm.Message) {
	@Messages(chatID, messages...)
}

templ PendingSubmission(chatID string, requestID string, message llm.Message, model string, tools []string) {
	<hx-partial hx-target="#message-history" hx-swap="beforeend">
		@Messages(chatID, message)
	</hx-partial>
	@PendingCompletion(chatID, requestID, model, tools)
	@MessageInput("", true)
}

templ EditedSubmission(chatID string, requestID string, messages []llm.Message, model string, tools []string) {
	<div id="message-history">
		@Messages(chatID, messages...)
	</div>
	@PendingCompletion(chatID, requestID, model, tools)
}

templ ChatTitleRequest(chatID string) {
	<div
		id="chat-title-request"
		hx-post={ "/chats/" + chatID + "/title" }
		hx-trigger="load"
		hx-indicator="this"
		hx-target="this"
		hx-swap="outerHTML"
	></div>
}

templ ChatTitleComplete() {
	<div id="chat-title-request" hidden></div>
}

templ CompletionCheckpoint(chatID string, messages []llm.Message) {
	<hx-partial hx-target="#message-history" hx-swap="innerHTML">
		@Messages(chatID, messages...)
	</hx-partial>
}

templ CompletionResult(chatID string, messages []llm.Message, items []kritui_db.InboxItem) {
	@CompletionCheckpoint(chatID, messages)
	@InboxCheckpoint(chatID, items)
}

templ ActiveCompletionResult(chatID string, messages []llm.Message, items []kritui_db.InboxItem) {
	@CompletionResult(chatID, ActiveCompletionView(messages).Messages, items)
}

templ InboxCheckpoint(chatID string, items []kritui_db.InboxItem) {
	<hx-partial hx-target="#prompt-inbox" hx-swap="outerHTML">
		@PromptInbox(chatID, items)
	</hx-partial>
}

templ ClearCompletionErrors() {
	<hx-partial hx-target="#messages > .completion-error" hx-swap="delete"></hx-partial>
}

templ PendingCompletion(chatID string, requestID string, model string, tools []string) {
	@pendingCompletion(chatID, requestID, model, tools, true, CompletionView{})
}

templ ActiveCompletion(chatID string, requestID string, model string, tools []string) {
	@pendingCompletion(chatID, requestID, model, tools, false, CompletionView{})
}

templ CompletionWithHistory(chatID string, requestID string, model string, tools []string, start bool, messages []llm.Message) {
	@pendingCompletion(chatID, requestID, model, tools, start, ActiveCompletionView(messages))
}

templ pendingCompletion(chatID string, requestID string, model string, tools []string, start bool, view CompletionView) {
	<article
		class="message loading-message completion-active"
		id={ "completion-" + requestID }
		if len(view.Messages) == 1 && view.Messages[0].Role == "user" {
			data-first-turn-completion
		}
		if start && len(view.Messages) == 1 && view.Messages[0].Role == "user" {
			hx-indicator="this"
		}
		if start {
			hx-post={ "/messages/complete?chat=" + chatID }
			hx-trigger="load"
			hx-include="this"
			hx-sync="#messages:queue last"
		}
		hx-vals={ `js:{client_timezone: Intl.DateTimeFormat().resolvedOptions().timeZone}` }
		hx-target="this"
		hx-swap="outerHTML"
		role="status"
		aria-label="Waiting for model response"
	>
		<div
			class="completion-progress"
			hx-sse:connect={ "/messages/tools?request=" + requestID }
			hx-sse:close="close"
			hx-config="sse.pauseOnBackground:false"
		>
			<div
				class="tool-call-list"
				role="list"
				id={ "completion-tools-" + requestID }
			>
				@ToolCalls(view.ToolCalls, "", view.ToolErrors)
			</div>
			<strong class="thinking-indicator"><span class="braille-spinner" aria-hidden="true"></span>{ model }</strong>
		</div>
		<div class="completion-network-error" role="alert" hidden>
			@CompletionErrorDetails("Failed to complete message. Check your connection and retry.", model)
			@CompletionRetry(chatID, model, tools)
		</div>
		<input type="hidden" name="request" value={ requestID }/>
	</article>
}

templ MessageError(message string) {
	<article class="message" role="alert">
		<div class="message-content plain-text">{ message }</div>
	</article>
}

templ CompletionError(chatID string, message string, model string, tools []string) {
	<article class="message completion-error" role="alert">
		@CompletionErrorDetails(message, model)
		@CompletionRetry(chatID, model, tools)
	</article>
}

templ CompletionErrorWithReference(chatID string, message string, requestID string, model string, tools []string) {
	<article class="message completion-error" role="alert">
		@CompletionErrorDetails(message, model)
		if requestID != "" {
			<p class="completion-error-reference">Diagnostic ID: <code>{ requestID }</code></p>
		}
		@CompletionRetry(chatID, model, tools)
	</article>
}

templ CompletionErrorDetails(message string, model string) {
	<strong class="completion-error-model">{ model }</strong>
	<div class="message-content plain-text completion-error-message" data-completion-error-message>{ message }</div>
}

templ CompletionRetry(chatID string, model string, tools []string) {
	<form
		class="completion-retry"
		hx-post={ "/messages/retry?chat=" + chatID }
		hx-target="closest article"
		hx-swap="outerHTML"
		hx-sync="#messages:drop"
		hx-disable="find button[type='submit']"
	>
		<input type="hidden" name="model" value={ model }/>
		for _, tool := range tools {
			<input type="hidden" name="tool" value={ tool }/>
		}
		<button class="completion-retry-button" type="submit" aria-label="Retry completion" title="Retry completion">
			Retry
		</button>
	</form>
}

templ MessageHistoryResult(chatID string, messages []llm.Message, input string) {
	@MessageList(chatID, messages, false)
	@MessageInput(input, true)
}

templ MessageInput(value string, outOfBand bool) {
	if outOfBand {
		<textarea id="message" name="message" rows="1" placeholder="Write a message..." enterkeyhint="enter" required autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="command-autocomplete" aria-expanded="false" hx-swap-oob="outerHTML">{ value }</textarea>
	} else {
		<textarea id="message" name="message" rows="1" placeholder="Write a message..." enterkeyhint="enter" required autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="command-autocomplete" aria-expanded="false" autofocus>{ value }</textarea>
	}
}
