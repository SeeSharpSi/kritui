package templates

import (
	"fmt"
	"strings"
	"seesharpsi/kritui/llm"
	"seesharpsi/kritui/markdown"
)

func messageModelMeta(message llm.Message) string {
	var parts []string
	if message.TotalTokens != nil {
		parts = append(parts, fmt.Sprintf("%d tokens", *message.TotalTokens))
	}
	if message.Cost != nil {
		parts = append(parts, fmt.Sprintf("$%.4f", *message.Cost))
	}
	return strings.Join(parts, " · ")
}

// toolCallArgsBody is args without trailing `}` so CSS can ellipsis then keep `}`.
func toolCallArgsBody(args string) string {
	return strings.TrimSuffix(args, "}")
}

// messageView is one UI block: combined tool-call rounds and/or a visible message.
type messageView struct {
	ToolCalls  []llm.ToolCall
	ToolErrors map[string]string
	Message    *llm.Message
}

// messagesForView merges consecutive assistant tool-call rounds into one group,
// matching the live completion tracker. Tool role messages stay hidden.
func messagesForView(messages []llm.Message) []messageView {
	var views []messageView
	var pending []llm.ToolCall
	var pendingErrors map[string]string
	flush := func() {
		if len(pending) == 0 {
			pendingErrors = nil
			return
		}
		views = append(views, messageView{ToolCalls: pending, ToolErrors: pendingErrors})
		pending = nil
		pendingErrors = nil
	}
	for i := range messages {
		message := &messages[i]
		switch {
		case message.Role == "tool":
			if toolError := llm.ToolErrorMessage(message.Content); toolError != "" {
				if pendingErrors == nil {
					pendingErrors = make(map[string]string)
				}
				pendingErrors[message.ToolCallID] = toolError
			}
			continue
		case message.Role == "assistant" && len(message.ToolCalls) > 0:
			pending = append(pending, message.ToolCalls...)
		default:
			flush()
			views = append(views, messageView{Message: message})
		}
	}
	flush()
	return views
}

templ Messages(messages ...llm.Message) {
	for _, view := range messagesForView(messages) {
		@CompletedToolCalls(view.ToolCalls, view.ToolErrors)
		if view.Message != nil {
			if view.Message.Role == "user" {
				@MessageAppends(view.Message.PromptAppends)
			}
			<article class={ "message" , templ.KV("user", view.Message.Role=="user" ) }>
				if view.Message.Role == "assistant" {
					<strong>{ view.Message.Model }</strong>
					if meta := messageModelMeta(*view.Message); meta != "" {
						<span class="message-meta"> · { meta }</span>
					}
					<div class="message-content markdown">
						@markdown.Render(view.Message.Content)
					</div>
				} else {
					<div class="message-content plain-text">{ view.Message.Content }</div>
				}
			</article>
		}
	}
}

templ MessageAppends(appends []string) {
	if len(appends) > 0 {
		<details class="message-appends">
			<summary>appends</summary>
			<div class="message-appends-content">
				for _, value := range appends {
					<div class="message-append">{ value }</div>
				}
			</div>
		</details>
	}
}

templ ToolCalls(calls []llm.ToolCall, runningID string, toolErrors map[string]string) {
	@toolCalls(calls, runningID, toolErrors)
}

templ toolCalls(calls []llm.ToolCall, runningID string, toolErrors map[string]string) {
	for _, call := range calls {
		<div class={ "tool-call", templ.KV("loading", call.ID == runningID), templ.KV("tool-error", toolErrors[call.ID] != "") } role="listitem">
			if call.ID == runningID {
				<span class="braille-spinner" aria-hidden="true"></span>
				<span class="visually-hidden">Running tool: </span>
			} else {
				<span class="tool-call-complete" aria-hidden="true"></span>
				if toolErrors[call.ID] != "" {
					<span class="visually-hidden">Failed tool: </span>
				} else {
					<span class="visually-hidden">Completed tool: </span>
				}
			}
			if call.Function.Arguments != "" && call.Function.Arguments != "{}" || toolErrors[call.ID] != "" {
				<button
					type="button"
					class="tool-call-toggle"
					aria-expanded="false"
				>{ call.Function.Name }</button>
				if call.Function.Arguments == "{}" {
					<code>{ call.Function.Arguments }</code>
				} else if strings.HasSuffix(call.Function.Arguments, "}") {
					<code><span>{ toolCallArgsBody(call.Function.Arguments) }</span>{ "}" }</code>
				} else if call.Function.Arguments != "" {
					<code><span>{ call.Function.Arguments }</span></code>
				}
				if toolErrors[call.ID] != "" {
					<div class="tool-call-error" role="alert">{ toolErrors[call.ID] }</div>
				}
			} else {
				<strong>{ call.Function.Name }</strong>
			}
		</div>
	}
}

templ CompletedToolCalls(calls []llm.ToolCall, toolErrors map[string]string) {
	if len(calls) > 0 {
		<details class="completed-tool-calls">
			<summary>
				if len(calls) == 1 {
					1 tool call used
				} else {
					{ fmt.Sprintf("%d tool calls used", len(calls)) }
				}
			</summary>
			<div class="tool-call-list" role="list">
				@toolCalls(calls, "", toolErrors)
			</div>
		</details>
	}
}

templ CompletedMessage(messages ...llm.Message) {
	@Messages(messages...)
}

templ PendingSubmission(chatID string, requestID string, message llm.Message, model string, tools []string) {
	@Messages(message)
	@PendingCompletion(chatID, requestID, model, tools)
	@MessageInput(true)
}

templ PendingCompletion(chatID string, requestID string, model string, tools []string) {
	<article
		class="message loading-message"
		hx-post={ "/messages/complete?chat=" + chatID }
		hx-trigger="load"
		hx-target="this"
		hx-swap="outerHTML"
		hx-include="this"
		hx-sync="#messages:queue last"
		hx-disabled-elt="#message-form button[type='submit']"
		hx-ext="sse"
		sse-connect={ "/messages/tools?request=" + requestID }
		sse-close="close"
		role="status"
		aria-label="Waiting for model response"
	>
		<div class="completion-progress">
			<div
				class="tool-call-list"
				role="list"
				sse-swap="tools"
				hx-target="this"
				hx-swap="innerHTML"
			></div>
			<strong class="thinking-indicator"><span class="braille-spinner" aria-hidden="true"></span>{ model }</strong>
		</div>
		<div class="completion-network-error" role="alert" hidden>
			@CompletionErrorDetails("Failed to complete message. Check your connection and retry.", model)
			@CompletionRetry(chatID, model, tools)
		</div>
		<input type="hidden" name="request" value={ requestID }/>
	</article>
}

templ MessageError(message string) {
	<article class="message" role="alert">
		<div class="message-content plain-text">{ message }</div>
	</article>
}

templ CompletionError(chatID string, message string, model string, tools []string) {
	<article class="message completion-error" role="alert">
		@CompletionErrorDetails(message, model)
		@CompletionRetry(chatID, model, tools)
	</article>
}

templ CompletionErrorDetails(message string, model string) {
	<strong class="completion-error-model">{ model }</strong>
	<div class="message-content plain-text completion-error-message" data-completion-error-message>{ message }</div>
}

templ CompletionRetry(chatID string, model string, tools []string) {
	<form
		class="completion-retry"
		hx-post={ "/messages/retry?chat=" + chatID }
		hx-target="closest article"
		hx-swap="outerHTML"
		hx-sync="#messages:drop"
		hx-disabled-elt="find button[type='submit']"
	>
		<input type="hidden" name="model" value={ model }/>
		for _, tool := range tools {
			<input type="hidden" name="tool" value={ tool }/>
		}
		<button class="completion-retry-button" type="submit" aria-label="Retry completion" title="Retry completion">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M20 6v6h-6"></path>
				<path d="M20 12a8 8 0 1 0-2.34 5.66"></path>
			</svg>
		</button>
	</form>
}

templ MessageInput(outOfBand bool) {
	if outOfBand {
		<input id="message" name="message" placeholder="Write a message..." required autocomplete="off" hx-swap-oob="outerHTML"/>
	} else {
		<input id="message" name="message" placeholder="Write a message..." required autocomplete="off" autofocus/>
	}
}
