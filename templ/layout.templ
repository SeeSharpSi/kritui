package templates

import (
	"seesharpsi/kritui/themes"
)

const staticAssetVersion = "67"

func staticAsset(path string) string {
	return path + "?v=" + staticAssetVersion
}

templ Layout(title string, theme themes.Theme) {
	<!DOCTYPE html>
	<html
		lang="en"
		data-theme={ theme.ID }
		style={ templ.SafeCSS(theme.Style) }
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="htmx-config" content={ `{"defaultTimeout":0,"defaultSettleDelay":20,"extensions":"sse"}` }/>
			<title>{ title }</title>
			<meta name="theme-color" content={ theme.Colors["background"] }/>
			<link rel="icon" href={ templ.URL(staticAsset("/static/logo.png")) } type="image/png"/>
			<link rel="icon" href={ templ.URL(staticAsset("/static/favicon.ico")) } sizes="any"/>
			<link rel="icon" href={ templ.URL(staticAsset("/static/icon-192.png")) } type="image/png"/>
			<link rel="apple-touch-icon" href={ templ.URL(staticAsset("/static/icon-192.png")) }/>
			<link rel="manifest" href={ templ.URL(staticAsset("/static/manifest.json")) }/>
			<script src={ templ.URL(staticAsset("/static/htmx.min.js")) }></script>
			<script src={ templ.URL(staticAsset("/static/hx-sse.js")) }></script>
			<script src={ templ.URL(staticAsset("/static/app.js")) } defer></script>
			<link rel="stylesheet" href={ templ.URL(staticAsset("/static/styles.css")) }/>
		</head>
		<body hx-indicator:inherited="global #request-overlay">
			<div id="request-overlay" class="request-overlay htmx-indicator" role="status" aria-live="polite" aria-label="Loading">
				<span class="braille-spinner" aria-hidden="true"></span>
			</div>
			{ children... }
			@ShareDialog(themes.Options(), theme)
			<dialog id="image-viewer" class="image-viewer" aria-label="Image viewer">
				<img id="image-viewer-image" class="image-viewer-image" alt=""/>
				<button
					type="button"
					class="image-viewer-close"
					data-image-viewer-close
					aria-label="Close image viewer"
					title="Close image viewer"
					autofocus
				>
					@Icon("M18 6 6 18", "M6 6l12 12")
				</button>
			</dialog>
			<dialog id="pdf-viewer" class="image-viewer pdf-viewer" aria-label="PDF viewer">
				<div class="pdf-viewer-panel">
					<div class="pdf-viewer-toolbar">
						<span id="pdf-viewer-name" class="pdf-viewer-name"></span>
						<div class="pdf-viewer-actions">
							<a
								id="pdf-viewer-open"
								class="pdf-viewer-open"
								data-pdf-viewer-open
								href="#"
								target="_blank"
								rel="noopener"
							>Open in new tab</a>
							<button
								type="button"
								class="image-viewer-close pdf-viewer-close"
								data-pdf-viewer-close
								aria-label="Close PDF viewer"
								title="Close PDF viewer"
								autofocus
							>
								@Icon("M18 6 6 18", "M6 6l12 12")
							</button>
						</div>
					</div>
					<iframe
						id="pdf-viewer-frame"
						class="pdf-viewer-frame"
						title="PDF document"
					></iframe>
				</div>
			</dialog>
			@ShareEncryptionScript()
		</body>
	</html>
}
