package templates

const staticAssetVersion = "4"

func staticAsset(path string) string {
	return path + "?v=" + staticAssetVersion
}

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ `{"defaultTimeout":0,"defaultSettleDelay":20,"extensions":"sse"}` }/>
			<title>{ title }</title>
			<link rel="icon" href={ templ.URL(staticAsset("/static/logo.png")) } type="image/png"/>
			<link rel="icon" href={ templ.URL(staticAsset("/static/favicon.ico")) } sizes="any"/>
			<link rel="icon" href={ templ.URL(staticAsset("/static/icon-192.png")) } type="image/png"/>
			<link rel="apple-touch-icon" href={ templ.URL(staticAsset("/static/icon-192.png")) }/>
			<link rel="manifest" href={ templ.URL(staticAsset("/static/manifest.json")) }/>
			<meta name="theme-color" content="#17151b"/>
			<script src={ templ.URL(staticAsset("/static/htmx.min.js")) }></script>
			<script src={ templ.URL(staticAsset("/static/hx-sse.js")) }></script>
			<script src={ templ.URL(staticAsset("/static/app.js")) } defer></script>
			<link rel="stylesheet" href={ templ.URL(staticAsset("/static/styles.css")) }/>
		</head>
		<body hx-indicator:inherited="global #request-overlay">
			<div id="request-overlay" class="request-overlay htmx-indicator" role="status" aria-live="polite" aria-label="Loading">
				<span class="braille-spinner" aria-hidden="true"></span>
			</div>
			{ children... }
		</body>
	</html>
}
