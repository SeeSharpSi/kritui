package templates

templ Layout(title string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<script src="/static/htmx.min.js"></script>
			<link rel="stylesheet" href="/static/styles.css"/>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
