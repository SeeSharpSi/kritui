package templates

// PreparedMessageShare renders the inert data needed by the sender's browser
// to encrypt one snapshot before publishing it. It is returned only to the
// authenticated owner and must never be inserted into the live document.
templ PreparedMessageShare(token, snapshotBase64URL string) {
	<div data-share-preparation data-share-token={ token }>
		<template data-share-snapshot>{ snapshotBase64URL }</template>
	</div>
}

// ShareEncryptionScript returns the trusted inline code that encrypts a
// prepared snapshot locally and publishes only ciphertext. The raw constant
// preserves the script bytes exactly; there are no external dependencies.
templ ShareEncryptionScript() {
	@templ.Raw(shareEncryptionScript)
}

const shareEncryptionScript = `<script>
(function () {
	'use strict';

	if (window.__krituiShareEncryptionInstalled) {
		return;
	}
	window.__krituiShareEncryptionInstalled = true;

	var MAX_CIPHERTEXT_BYTES = 16 * 1024 * 1024;
	var SHARE_TOKEN = /^[A-Za-z0-9_-]{43}$/;
	var BASE64URL = /^[A-Za-z0-9_-]+$/;
	var busyForms = new WeakSet();
	var sourceForms = new WeakMap();

	function parseInert(html) {
		var template = document.createElement('template');
		template.innerHTML = html;
		return template.content;
	}

	function decodeBase64URL(value) {
		if (typeof value !== 'string' || value.length === 0 || !BASE64URL.test(value)) {
			throw new Error('Invalid base64url data.');
		}
		var remainder = value.length % 4;
		if (remainder === 1) {
			throw new Error('Invalid base64url data.');
		}
		var padded = value;
		if (remainder !== 0) {
			padded += '='.repeat(4 - remainder);
		}
		var binary;
		try {
			binary = atob(padded.replace(/-/g, '+').replace(/_/g, '/'));
		} catch (error) {
			throw new Error('Invalid base64url data.');
		}
		var bytes = new Uint8Array(binary.length);
		for (var i = 0; i < binary.length; i += 1) {
			bytes[i] = binary.charCodeAt(i);
		}
		return bytes;
	}

	function encodeBase64URL(bytes) {
		var chunkSize = 0x8000;
		var binary = '';
		for (var offset = 0; offset < bytes.length; offset += chunkSize) {
			var chunk = bytes.subarray(offset, Math.min(offset + chunkSize, bytes.length));
			binary += String.fromCharCode.apply(null, chunk);
		}
		return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
	}

	function setStatus(form, message, state) {
		var dialogStatus = form.querySelector('.share-dialog-status');
		if (dialogStatus) {
			dialogStatus.textContent = message;
			dialogStatus.dataset.state = state || '';
			return;
		}
		if (typeof window.setShareStatus === 'function') {
			window.setShareStatus(form, message, state || '');
		}
	}

	function actionURL(form) {
		var raw = form.getAttribute('action');
		if (!raw) {
			throw new Error('Share action is missing.');
		}
		var url = new URL(raw, window.location.href);
		if (url.origin !== window.location.origin) {
			throw new Error('Share action is not same-origin.');
		}
		return url;
	}

	function post(url, body) {
		return fetch(url, {
			method: 'POST',
			credentials: 'same-origin',
			headers: {
				'Accept': 'text/html',
				'HX-Current-URL': window.location.origin + window.location.pathname + window.location.search,
				'HX-Request': 'true'
			},
			body: body
		});
	}

	function followHXRedirect(response) {
		var location = response.headers.get('HX-Redirect');
		if (!location) {
			return false;
		}
		var target;
		try {
			target = new URL(location, window.location.origin);
		} catch (error) {
			return false;
		}
		if (target.origin !== window.location.origin) {
			return false;
		}
		window.location.assign(target.href);
		return true;
	}

	function shareError(message) {
		var error = new Error(message);
		error.shareMessage = message;
		return error;
	}

	async function createEncryptedShare(form, submitButton) {
		busyForms.add(form);
		submitButton.disabled = true;
		form.classList.add('htmx-request');
		setStatus(form, '');
		try {
			if (!window.isSecureContext || !window.crypto || !window.crypto.subtle) {
				throw shareError('Encrypted shares require HTTPS. Try again over a secure connection.');
			}

			var sourceForm = sourceForms.get(form);
			if (!sourceForm || !sourceForm.isConnected) {
				throw new Error('Share source is no longer available.');
			}
			var url = actionURL(sourceForm);
			var options = new URLSearchParams();
			options.set('title', form.elements.title.value);
			options.set('theme', form.elements.theme.value);
			options.set('mode', form.elements.mode.value);
			options.set('markdown', form.elements.mode.value === 'whole' ? '' : form.elements.markdown.value);
			var preparationResponse = await post(url, options);
			if (followHXRedirect(preparationResponse)) {
				return;
			}
			if (!preparationResponse.ok) {
				throw new Error('Share preparation failed.');
			}

			var preparation = parseInert(await preparationResponse.text());
			var container = preparation.querySelector('[data-share-preparation]');
			var token = container ? container.getAttribute('data-share-token') || '' : '';
			if (!SHARE_TOKEN.test(token)) {
				throw new Error('Share preparation response is invalid.');
			}
			var snapshotTemplate = container.querySelector('template[data-share-snapshot]');
			var snapshotText = '';
			if (snapshotTemplate) {
				snapshotText = (snapshotTemplate.content ? snapshotTemplate.content.textContent : snapshotTemplate.textContent || '').trim();
			}
			var snapshotBytes = decodeBase64URL(snapshotText);
			if (snapshotBytes.length === 0) {
				throw new Error('Share snapshot is empty.');
			}

			var key = await window.crypto.subtle.generateKey(
				{ name: 'AES-GCM', length: 256 },
				true,
				['encrypt', 'decrypt']
			);
			var rawKey = new Uint8Array(await window.crypto.subtle.exportKey('raw', key));
			if (rawKey.length !== 32) {
				throw new Error('Share key is invalid.');
			}
			var nonce = window.crypto.getRandomValues(new Uint8Array(12));
			var ciphertext = new Uint8Array(await window.crypto.subtle.encrypt(
				{ name: 'AES-GCM', iv: nonce, tagLength: 128 },
				key,
				snapshotBytes
			));
			if (ciphertext.length > MAX_CIPHERTEXT_BYTES) {
				throw shareError('This response is too large to share.');
			}

			var publishURL = new URL(url.pathname.replace(/\/+$/, '') + '/publish', url.origin);
			var publishBody = new URLSearchParams();
			publishBody.set('token', token);
			publishBody.set('format_version', '1');
			publishBody.set('nonce', encodeBase64URL(nonce));
			publishBody.set('ciphertext', encodeBase64URL(ciphertext));

			var publishResponse = await post(publishURL, publishBody);
			if (followHXRedirect(publishResponse)) {
				return;
			}
			if (!publishResponse.ok) {
				throw new Error('Share publish failed.');
			}

			var success = parseInert(await publishResponse.text());
			var replacements = success.querySelectorAll('form.message-share-actions');
			if (replacements.length !== 1) {
				throw new Error('Share publish response is invalid.');
			}
			var replacement = replacements[0];
			var copyButton = replacement.querySelector('button.message-share-copy-button[data-share-url]');
			if (!copyButton) {
				throw new Error('Share publish response has no copy control.');
			}
			var sharePath = '/s/' + token;
			if (copyButton.getAttribute('data-share-url') !== sharePath) {
				throw new Error('Share publish response has the wrong share path.');
			}

			copyButton.removeAttribute('data-share-copy-pending');
			var encodedKey = encodeBase64URL(rawKey);
			rawKey.fill(0);
			copyButton.dataset.shareUrl = sharePath + '#key=' + encodedKey;

			if (!sourceForm.isConnected) {
				return;
			}
			sourceForm.replaceWith(replacement);
			if (window.htmx && typeof window.htmx.process === 'function') {
				window.htmx.process(replacement);
			}
			var dialog = form.closest('dialog');
			if (dialog && dialog.open) {
				dialog.close();
			}
			if (typeof window.copyShareLink === 'function') {
				await window.copyShareLink(copyButton);
			}
		} catch (error) {
			if (form.isConnected) {
				var message = error && error.shareMessage
					? error.shareMessage
					: 'Could not create encrypted share. Try again.';
				setStatus(form, message, 'error');
			}
		} finally {
			busyForms.delete(form);
			if (form.isConnected) {
				submitButton.disabled = false;
				form.classList.remove('htmx-request');
			}
		}
	}

	function refreshShareTitle(sourceForm, dialog, form, fallbackTitle) {
		var action;
		try {
			action = new URL(sourceForm.getAttribute('action'), window.location.href);
		} catch (error) {
			return;
		}
		var match = action.pathname.match(/^\/chats\/([1-9]\d*)\/messages\/[1-9]\d*\/share$/);
		if (!match) {
			return;
		}
		fetch('/chats/' + match[1] + '/summary', {
			credentials: 'same-origin',
			headers: { 'Accept': 'text/html' }
		})
			.then(function (response) {
				return response.ok ? response.text() : '';
			})
			.then(function (html) {
				if (!html || !dialog.open || sourceForms.get(form) !== sourceForm || form.elements.title.value !== fallbackTitle) {
					return;
				}
				var fragment = parseInert(html);
				var title = fragment.querySelector('.chat-summary-title')?.textContent.trim();
				if (title) {
					form.elements.title.value = title;
				}
			})
			.catch(function () {});
	}

	document.addEventListener('click', function (event) {
		var opener = event.target.closest('[data-share-open]');
		if (opener) {
			var sourceForm = opener.closest('form.message-share-actions');
			var dialog = document.getElementById('share-dialog');
			var form = document.getElementById('share-options-form');
			if (!sourceForm || !dialog || !form) return;
			sourceForms.set(form, sourceForm);
			form.action = opener.getAttribute('data-share-action') || sourceForm.action;
			var chatTitle = document.querySelector('.chat[data-chat-title]')?.dataset.chatTitle || '';
			var titleAtOpen = chatTitle || 'New chat';
			form.elements.title.value = titleAtOpen;
			var markdown = opener.parentElement.querySelector('template[data-share-markdown]');
			form.elements.markdown.value = markdown ? markdown.content.textContent : '';
			var currentTheme = document.documentElement.dataset.theme;
			if (Array.from(form.elements.theme.options).some((option) => option.value === currentTheme)) {
				form.elements.theme.value = currentTheme;
			}
			form.elements.mode.value = 'recent';
			form.elements.markdown.disabled = false;
			form.querySelector('.share-dialog-status').textContent = '';
			dialog.showModal();
			form.elements.title.focus();
			refreshShareTitle(sourceForm, dialog, form, titleAtOpen);
			return;
		}
		if (event.target.closest('[data-share-close]')) {
			event.target.closest('dialog')?.close();
		}
	}, true);

	document.addEventListener('change', function (event) {
		if (event.target.matches('#share-options-form input[name="mode"]')) {
			var form = event.target.form;
			var disabled = form.elements.mode.value === 'whole';
			form.elements.markdown.disabled = disabled;
		}
	}, true);

	document.addEventListener('submit', function (event) {
		var form = event.target;
		if (!(form instanceof HTMLFormElement) || !form.classList.contains('share-options-form')) {
			return;
		}
		var submitButton = form.querySelector('button[type="submit"]');
		if (!submitButton) {
			return;
		}

		event.preventDefault();
		event.stopPropagation();
		event.stopImmediatePropagation();
		if (busyForms.has(form)) {
			return;
		}
		createEncryptedShare(form, submitButton);
	}, true);
})();
</script>`
