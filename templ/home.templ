package templates

import (
	"slices"

	"seesharpsi/kritui/llm"
)

templ Home(chatID string, messages []llm.Message, models []string, selectedModel string, defaultModel string, maxToolRounds int, tools []string, enabledTools []string) {
	@Layout("Kritui") {
		<main hx-history="false">
			<section class="chat">
				<div class="message-panel">
					@MessageList(messages, false)
					<div id="page-panel">
						@SettingsPage(chatID, models, defaultModel, maxToolRounds, false, false, "")
						@HistoryPage(chatID)
					</div>
				</div>
				<details class="chat-options">
					<div class="chat-options-list">
						<details class="model-picker">
							<summary>
								Model
								<strong>
									{ selectedModel }
								</strong>
							</summary>
							<div class="model-options">
								for _, model := range models {
									<label>
										<input
											type="radio"
											name="model"
											value={ model }
											form="message-form"
											if model == selectedModel {
												checked
											}
											onchange="this.closest('details').querySelector('strong').textContent = this.value; this.closest('details').removeAttribute('open')"
										/>
										<span>{ model }</span>
									</label>
								}
							</div>
						</details>
						<details class="tool-picker">
							<summary>
								Tools
							</summary>
							<div class="tool-options">
								for _, tool := range tools {
									<label>
										<input type="checkbox" name="tool" value={ tool } form="message-form" if slices.Contains(enabledTools, tool) { checked }/>
										<span>{ tool }</span>
										<span class="tool-state" aria-hidden="true"></span>
									</label>
								}
							</div>
						</details>
					</div>
					<summary style="outline: none;">
						<span class="visually-hidden">Toggle chat options</span>
					</summary>
				</details>
			</section>
			<form
				id="message-form"
				hx-post={ "/messages?chat=" + chatID }
				hx-target="#messages"
				hx-swap="beforeend"
				hx-trigger="submit queue:none"
				hx-sync="#messages:drop"
				hx-disabled-elt="find button[type='submit']"
			>
				<label for="message" class="visually-hidden">Message</label>
				@MessageInput(false)
				@SettingsButton()
				@HistoryButton()
				@SendButton()
			</form>
		</main>
	}
}

templ PageError(message string) {
	@Layout("Kritui") {
		<main hx-history="false">
			<section class="chat">
				<div class="message-panel">
					<div class="message-list">
						<div id="messages" class="message-thread">
							@MessageError(message)
						</div>
					</div>
				</div>
			</section>
		</main>
	}
}

templ SendButton() {
	<button id="send-button" type="submit">Send</button>
}
