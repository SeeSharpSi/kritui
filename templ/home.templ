package templates

import (
	"slices"
	"strconv"
	"strings"

	"seesharpsi/kritui/commands"
	kritui_db "seesharpsi/kritui/db"
	"seesharpsi/kritui/llm"
	"seesharpsi/kritui/themes"
)

// HomeData groups every input the chat page renders. Field names replace a
// sixteen-parameter positional list so same-typed values cannot transpose.
type HomeData struct {
	ChatID                   string
	ChatURL                  string
	Messages                 []llm.Message
	Models                   []string
	SelectedModel            string
	DefaultModel             string
	MaxToolRounds            int
	TitleGenerationEnabled   bool
	TitleGenerationModel     string
	SystemPrompt             string
	ToolResultElision        llm.ToolResultElisionConfig
	Tools                    []string
	EnabledTools             []string
	DefaultTools             []string
	MCPServers               []kritui_db.MCPServer
	PromptAppends            []kritui_db.PromptAppend
	NtfySettings             kritui_db.NtfySettings
	LLMSettings              kritui_db.LLMSettings
	LLMEnvironmentConfigured bool
	EnabledAppendIDs         []string
	CompletionRequestID      string
	CompletionStarted        bool
	CompletionInterrupted    bool
	Inbox                    []kritui_db.InboxItem
	CommandDefinitions       []commands.Definition
	Theme                    themes.Theme
}

templ Home(data HomeData) {
	@Layout("Kritui", data.Theme) {
		<main class="app-main">
			<div class="shell-scroll">
				<div class="shell-viewport">
					<section class="chat">
						<div class="message-panel">
							@MessageList(data.ChatID, homeHistory(data), false) {
								if data.CompletionRequestID != "" {
									@CompletionWithHistory(data.ChatID, data.CompletionRequestID, data.SelectedModel, data.EnabledTools, !data.CompletionStarted, data.Messages)
								} else if data.CompletionInterrupted || len(data.Messages) > 0 && data.Messages[len(data.Messages)-1].Role == "user" {
									@CompletionError(data.ChatID, "Completion was interrupted. Retry the completion.", data.SelectedModel, data.EnabledTools)
								}
							}
							<div id="page-panel">
								@SettingsPage(SettingsPanelData{
									ChatID:                   data.ChatID,
									Models:                   data.Models,
									SelectedModel:            data.DefaultModel,
									MaxToolRounds:            data.MaxToolRounds,
									TitleGenerationEnabled:   data.TitleGenerationEnabled,
									TitleGenerationModel:     data.TitleGenerationModel,
									SystemPrompt:             data.SystemPrompt,
									ToolResultElision:        data.ToolResultElision,
									ToolNames:                data.Tools,
									DefaultTools:             data.DefaultTools,
									MCPServers:               data.MCPServers,
									PromptAppends:            data.PromptAppends,
									NtfySettings:             data.NtfySettings,
									LLMSettings:              data.LLMSettings,
									LLMEnvironmentConfigured: data.LLMEnvironmentConfigured,
									Themes:                   themes.Options(),
									SelectedTheme:            data.Theme,
								})
								@HistoryPage(data.ChatID)
							</div>
						</div>
						@PromptInbox(data.ChatID, data.Inbox)
						@SettingsButton()
						<details class="chat-options">
							<summary aria-label="Toggle chat model">Model</summary>
							<div class="chat-options-list">
								<details class="model-picker">
									<summary>
										<strong>
											{ data.SelectedModel }
										</strong>
									</summary>
									<div class="model-options">
										for _, model := range data.Models {
											<label>
												<input
													type="radio"
													name="model"
													value={ model }
													form="message-form"
													if model == data.SelectedModel {
														checked
													}
													onchange="this.closest('details').querySelector('strong').textContent = this.value; this.closest('details').removeAttribute('open')"
												/>
												<span>{ model }</span>
											</label>
										}
									</div>
								</details>
								@ToolPicker(data.Tools, data.MCPServers, data.EnabledTools, false)
								@AppendsPicker(data.PromptAppends, data.EnabledAppendIDs, false)
							</div>
						</details>
						@HistoryButton()
						<div id="image-previews" class="image-previews" aria-label="Attached files" hidden></div>
					</section>
					<form
						id="message-form"
						enctype="multipart/form-data"
						hx-post={ "/messages?chat=" + data.ChatID }
						hx-encoding="multipart/form-data"
						hx-target="#messages"
						hx-swap="beforeend"
						hx-trigger="submit"
						hx-sync="#messages:drop"
						hx-disable="find button[type='submit']"
						if data.ChatURL != "" {
							hx-replace-url={ data.ChatURL }
						}
					>
						<input id="image-input" type="file" name="image" accept="image/png,image/jpeg,image/jpg,image/webp,application/pdf,.jpg,.jpeg,.pdf" multiple class="visually-hidden" tabindex="-1" aria-hidden="true"/>
						<input id="message-submission" type="hidden" name="submission" value=""/>
						<div id="image-paste-status" class="visually-hidden" role="status" aria-live="polite"></div>
						<label for="message" class="visually-hidden">Message</label>
						<div id="command-autocomplete" class="command-autocomplete" role="listbox" aria-label="Slash commands" hidden>
							for _, definition := range data.CommandDefinitions {
								<div
									id={ "command-option-" + definition.Name }
									class="command-option"
									role="option"
									aria-selected="false"
									data-command-name={ definition.Name }
									if definition.RequiresArguments {
										data-command-requires-arguments="true"
									}
								>
									<span class="command-name">{ "/" + definition.Name }</span>
									<span class="command-description">{ definition.Description }</span>
								</div>
							}
						</div>
						@MessageInput("", false)
						@AttachButton()
						@QueueButton(data.CompletionRequestID != "")
						@SendButton()
					</form>
				</div>
				<div class="shell-tail" aria-hidden="true"></div>
			</div>
		</main>
	}
}

func homeHistory(data HomeData) []llm.Message {
	if data.CompletionRequestID != "" {
		return ActiveCompletionView(data.Messages).Messages
	}
	return data.Messages
}

templ PromptInbox(chatID string, items []kritui_db.InboxItem) {
	<section
		id="prompt-inbox"
		class="prompt-inbox"
		aria-label="Pending inputs"
		if len(items) == 0 {
			hidden
		}
	>
		if len(items) > 0 {
			for _, item := range items {
				<article class="prompt-inbox-item" data-inbox-id={ strconv.FormatInt(item.ID, 10) }>
					<div class="prompt-inbox-summary">
						<span class={ "prompt-inbox-delivery", templ.KV("is-queued", item.Delivery != "steer") }>{ inboxDeliveryLabel(item) }</span>
						<span class="prompt-inbox-preview">{ inboxPreview(item) }</span>
						if item.Delivery != "steer" && item.Model != "" {
							<span class="prompt-inbox-model">{ item.Model }</span>
						}
					</div>
					if len(item.Message.Attachments) > 0 {
						<div class="prompt-inbox-attachments" aria-label="Pending attachments">
							<span class="prompt-inbox-attachment-count">{ strconv.Itoa(len(item.Message.Attachments)) + " attachment" + inboxPlural(len(item.Message.Attachments)) }</span>
							for _, attachment := range item.Message.Attachments {
								<span class="prompt-inbox-attachment">{ inboxAttachmentLabel(attachment) }</span>
							}
						</div>
					}
					<div class="prompt-inbox-actions">
						if item.Delivery == "steer" {
							<button
								type="button"
								class="prompt-inbox-action"
								hx-patch={ inboxItemURL(chatID, item.ID) }
								hx-vals={ `{"delivery":"queue"}` }
								hx-target="#prompt-inbox"
								hx-swap="outerHTML"
								hx-sync="#prompt-inbox:drop"
								hx-disable="this"
								aria-label="Queue this pending input"
								title="Queue this pending input"
							>Queue</button>
						} else {
							<button
								type="button"
								class="prompt-inbox-action"
								hx-patch={ inboxItemURL(chatID, item.ID) }
								hx-vals={ `{"delivery":"steer"}` }
								hx-target="#prompt-inbox"
								hx-swap="outerHTML"
								hx-sync="#prompt-inbox:drop"
								hx-disable="this"
								aria-label="Steer this pending input now"
								title="Steer this pending input after the next model step"
							>Steer now</button>
						}
						<button
							type="button"
							class="prompt-inbox-action prompt-inbox-remove"
							hx-delete={ inboxItemURL(chatID, item.ID) }
							hx-target="#prompt-inbox"
							hx-swap="outerHTML"
							hx-sync="#prompt-inbox:drop"
							hx-disable="this"
							aria-label="Remove this pending input"
							title="Remove this pending input"
						>Remove</button>
					</div>
				</article>
			}
		}
	</section>
}

func inboxItemURL(chatID string, id int64) string {
	return "/chats/" + chatID + "/inbox/" + strconv.FormatInt(id, 10)
}

func inboxDeliveryLabel(item kritui_db.InboxItem) string {
	if item.Delivery == "steer" {
		return "Steer"
	}
	return "Queued"
}

func inboxPreview(item kritui_db.InboxItem) string {
	if strings.TrimSpace(item.Message.Content) == "" {
		return "Attachment-only message"
	}
	return item.Message.Content
}

func inboxAttachmentLabel(attachment llm.UserAttachment) string {
	if attachment.Filename != "" {
		return attachment.Filename
	}
	if attachment.MediaType == "application/pdf" {
		return "PDF"
	}
	return "Image"
}

func inboxPlural(count int) string {
	if count == 1 {
		return ""
	}
	return "s"
}

templ InboxSubmission(chatID string, items []kritui_db.InboxItem) {
	<hx-partial hx-target="#prompt-inbox" hx-swap="outerHTML">
		@PromptInbox(chatID, items)
	</hx-partial>
	@MessageInput("", true)
}

templ ToolPicker(builtinTools []string, mcpServers []kritui_db.MCPServer, enabledTools []string, outOfBand bool) {
	<details
		id="tool-picker"
		class="tool-picker"
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		<summary>Tools</summary>
		<div class="tool-options">
			for _, tool := range builtinTools {
				<label>
					<input type="checkbox" name="tool" value={ tool } form="message-form" if slices.Contains(enabledTools, tool) { checked }/>
					<span>{ tool }</span>
					<span class="tool-state" aria-hidden="true"></span>
				</label>
			}
			for _, server := range mcpServers {
				<label>
					<input type="checkbox" name="tool" value={ kritui_db.MCPServerCapability(server.ID) } form="message-form" if slices.Contains(enabledTools, kritui_db.MCPServerCapability(server.ID)) { checked }/>
					<span>{ server.Name }</span>
					<span class="tool-state" aria-hidden="true"></span>
				</label>
			}
		</div>
	</details>
}

templ AppendsPicker(promptAppends []kritui_db.PromptAppend, enabledAppendIDs []string, outOfBand bool) {
	<details
		id="append-picker"
		class="append-picker"
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		<summary>
			Appends
		</summary>
		<div class="append-options">
			for _, preset := range promptAppends {
				<label>
					<input type="checkbox" name="append" value={ preset.ID } form="message-form" if slices.Contains(enabledAppendIDs, preset.ID) { checked }/>
					<span>{ preset.Name }</span>
					<span class="append-state" aria-hidden="true"></span>
				</label>
			}
		</div>
	</details>
}

templ PageError(message string) {
	@Layout("Kritui", themes.Default()) {
		<main>
			<section class="chat">
				<div class="message-panel">
					<div class="message-list">
						<div id="messages" class="message-thread">
							@MessageError(message)
						</div>
					</div>
				</div>
			</section>
		</main>
	}
}

templ SendButton() {
	<button id="send-button" type="submit" name="delivery" value="steer" aria-label="Send message" title="Send message">
		@Icon("M22 2 11 13", "M22 2 15 22 11 13 2 9 22 2")
		<span class="visually-hidden" data-send-label>Send</span>
	</button>
}

templ QueueButton(completionActive bool) {
	<button
		id="queue-button"
		type="submit"
		name="delivery"
		value="queue"
		aria-label="Queue after completion"
		title="Queue after this completion finishes"
		if !completionActive {
			hidden
		}
	>
		@Icon("M12 6v6l4 2", "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0")
		<span class="visually-hidden">Queue</span>
	</button>
}

templ AttachButton() {
	<button id="attach-button" type="button" aria-label="Attach images or PDFs" title="Attach images or PDFs">
		@Icon("M12 5v14", "M5 12h14")
	</button>
}
