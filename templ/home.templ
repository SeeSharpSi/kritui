package templates

import (
	"slices"

	"seesharpsi/kritui/commands"
	kritui_db "seesharpsi/kritui/db"
	"seesharpsi/kritui/llm"
)

templ Home(chatID string, chatURL string, messages []llm.Message, models []string, selectedModel string, defaultModel string, maxToolRounds int, tools []string, enabledTools []string, defaultTools []string, promptAppends []kritui_db.PromptAppend, ntfySettings kritui_db.NtfySettings, enabledAppendIDs []string, completionRequestID string, completionStarted bool, commandDefinitions []commands.Definition) {
	@Layout("Kritui") {
		<main hx-history="false">
			<section class="chat">
				<div class="message-panel">
					@MessageList(chatID, messages, false) {
						if completionRequestID != "" {
							if completionStarted {
								@ActiveCompletion(chatID, completionRequestID, selectedModel, enabledTools)
							} else {
								@PendingCompletion(chatID, completionRequestID, selectedModel, enabledTools)
							}
						} else if len(messages) > 0 && messages[len(messages)-1].Role == "user" {
							@CompletionError(chatID, "Completion was interrupted. Retry the completion.", selectedModel, enabledTools)
						}
					}
					<div id="page-panel">
						@SettingsPage(chatID, models, defaultModel, maxToolRounds, tools, defaultTools, promptAppends, ntfySettings, false, false, "")
						@HistoryPage(chatID)
					</div>
				</div>
				@SettingsButton()
				<details class="chat-options">
					<div class="chat-options-list">
						<details class="model-picker">
							<summary>
								Model
								<strong>
									{ selectedModel }
								</strong>
							</summary>
							<div class="model-options">
								for _, model := range models {
									<label>
										<input
											type="radio"
											name="model"
											value={ model }
											form="message-form"
											if model == selectedModel {
												checked
											}
											onchange="this.closest('details').querySelector('strong').textContent = this.value; this.closest('details').removeAttribute('open')"
										/>
										<span>{ model }</span>
									</label>
								}
							</div>
						</details>
						<details class="tool-picker">
							<summary>
								Tools
							</summary>
							<div class="tool-options">
								for _, tool := range tools {
									<label>
										<input type="checkbox" name="tool" value={ tool } form="message-form" if slices.Contains(enabledTools, tool) { checked }/>
										<span>{ tool }</span>
										<span class="tool-state" aria-hidden="true"></span>
									</label>
								}
							</div>
						</details>
						@AppendsPicker(promptAppends, enabledAppendIDs, false)
					</div>
					<summary style="outline: none;">
						<span class="visually-hidden">Toggle chat options</span>
					</summary>
				</details>
				@HistoryButton()
			</section>
			<form
				id="message-form"
				hx-post={ "/messages?chat=" + chatID }
				hx-target="#messages"
				hx-swap="beforeend"
				hx-trigger="submit queue:none"
				hx-sync="#messages:drop"
				hx-disabled-elt="find button[type='submit']"
				if chatURL != "" {
					hx-replace-url={ chatURL }
				}
			>
				<label for="message" class="visually-hidden">Message</label>
				<div id="command-autocomplete" class="command-autocomplete" role="listbox" aria-label="Slash commands" hidden>
					for _, definition := range commandDefinitions {
						<div
							id={ "command-option-" + definition.Name }
							class="command-option"
							role="option"
							aria-selected="false"
							data-command-name={ definition.Name }
							if definition.RequiresArguments {
								data-command-requires-arguments="true"
							}
						>
							<span class="command-name">{ "/" + definition.Name }</span>
							<span class="command-description">{ definition.Description }</span>
						</div>
					}
				</div>
				@MessageInput("", false)
				@SendButton()
			</form>
		</main>
	}
}

templ AppendsPicker(promptAppends []kritui_db.PromptAppend, enabledAppendIDs []string, outOfBand bool) {
	<details
		id="append-picker"
		class="append-picker"
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		<summary>
			Appends
		</summary>
		<div class="append-options">
			for _, preset := range promptAppends {
				<label>
					<input type="checkbox" name="append" value={ preset.ID } form="message-form" if slices.Contains(enabledAppendIDs, preset.ID) { checked }/>
					<span>{ preset.Name }</span>
					<span class="append-state" aria-hidden="true"></span>
				</label>
			}
		</div>
	</details>
}

templ PageError(message string) {
	@Layout("Kritui") {
		<main hx-history="false">
			<section class="chat">
				<div class="message-panel">
					<div class="message-list">
						<div id="messages" class="message-thread">
							@MessageError(message)
						</div>
					</div>
				</div>
			</section>
		</main>
	}
}

templ SendButton() {
	<button id="send-button" type="submit" aria-label="Send message" title="Send message">
		@Icon("M22 2 11 13", "M22 2 15 22 11 13 2 9 22 2")
	</button>
}
