package templates

import "seesharpsi/kritui/llm"

templ Home(chatID string, messages []llm.Message, models []string, selectedModel string, tools []string) {
	@Layout("Kritui") {
		<main>
			<section class="chat">
				@MessageList(messages)
				<details class="chat-options">
					<summary style="outline: none;">
						<span class="visually-hidden">Toggle chat options</span>
					</summary>
					<div class="chat-options-list">
						<details class="model-picker">
							<summary style="display: flex; align-items: center; font-size: small;">
								Model
								<strong>
									{ selectedModel }
								</strong>
							</summary>
							<div class="model-options">
								for _, model := range models {
									<label>
										if model == selectedModel {
											<input
												type="radio"
												name="model"
												value={ model }
												form="message-form"
												checked
												onchange="this.closest('details').querySelector('strong').textContent = this.value; this.closest('details').removeAttribute('open')"
											/>
										} else {
											<input
												type="radio"
												name="model"
												value={ model }
												form="message-form"
												onchange="this.closest('details').querySelector('strong').textContent = this.value; this.closest('details').removeAttribute('open')"
											/>
										}
										<span>{ model }</span>
									</label>
								}
							</div>
						</details>
						<details class="tool-picker">
							<summary style="display: flex; align-items: center; font-size: small;">
								Tools <strong>Off</strong>
							</summary>
							<div class="tool-options">
								for _, tool := range tools {
									<label>
										<input type="checkbox" name="tool" value={ tool } form="message-form" onchange="updateToolSummary(this.closest('details'))"/>
										<span>{ tool }</span>
										<span class="tool-state" aria-hidden="true"></span>
									</label>
								}
							</div>
						</details>
					</div>
				</details>
			</section>
			<form
				id="message-form"
				hx-post={ "/messages?chat=" + chatID }
				hx-target="#messages"
				hx-swap="beforeend scroll:.message-list:bottom"
			>
				<label for="message" class="visually-hidden">Message</label>
				@MessageInput(false)
				@HistoryButton(chatID, false, false)
				<button type="submit">Send</button>
			</form>
			<script>
				const messageList = document.querySelector('.message-list');
				messageList.scrollTop = messageList.scrollHeight;

				function updateToolSummary(picker) {
					picker.querySelector('summary strong').textContent = picker.querySelector('input:checked') ? 'On' : 'Off';
				}
			</script>
		</main>
	}
}
