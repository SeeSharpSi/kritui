package templates

import "seesharpsi/kritui/llm"

func toolEnabled(enabled []string, name string) bool {
	for _, tool := range enabled {
		if tool == name {
			return true
		}
	}
	return false
}

templ Home(chatID string, messages []llm.Message, models []string, selectedModel string, tools []string, enabledTools []string) {
	@Layout("Kritui") {
		<main hx-history="false">
			<section class="chat">
				<div class="message-panel">
					@MessageList(messages)
					<div id="history-panel"></div>
				</div>
				<details class="chat-options">
					<div class="chat-options-list">
						<details class="model-picker">
							<summary style="display: flex; align-items: center; font-size: small;">
								Model
								<strong>
									{ selectedModel }
								</strong>
							</summary>
							<div class="model-options">
								for _, model := range models {
									<label>
										if model == selectedModel {
											<input
												type="radio"
												name="model"
												value={ model }
												form="message-form"
												checked
												onchange="this.closest('details').querySelector('strong').textContent = this.value; this.closest('details').removeAttribute('open')"
											/>
										} else {
											<input
												type="radio"
												name="model"
												value={ model }
												form="message-form"
												onchange="this.closest('details').querySelector('strong').textContent = this.value; this.closest('details').removeAttribute('open')"
											/>
										}
										<span>{ model }</span>
									</label>
								}
							</div>
						</details>
						<details class="tool-picker">
							<summary style="display: flex; align-items: center; font-size: small;">
								Tools
							</summary>
							<div class="tool-options">
								for _, tool := range tools {
									<label>
										if toolEnabled(enabledTools, tool) {
											<input type="checkbox" name="tool" value={ tool } form="message-form" checked/>
										} else {
											<input type="checkbox" name="tool" value={ tool } form="message-form"/>
										}
										<span>{ tool }</span>
										<span class="tool-state" aria-hidden="true"></span>
									</label>
								}
							</div>
						</details>
					</div>
					<summary style="outline: none;">
						<span class="visually-hidden">Toggle chat options</span>
					</summary>
				</details>
			</section>
			<form
				id="message-form"
				data-swap-errors
				hx-post={ "/messages?chat=" + chatID }
				hx-target="#messages"
				hx-swap="beforeend scroll:.message-list:bottom"
				hx-trigger="submit queue:none"
				hx-sync="#messages:drop"
				hx-disabled-elt="find button[type='submit']"
			>
				<label for="message" class="visually-hidden">Message</label>
				@MessageInput(false)
				@HistoryButton(chatID, false, false)
				<button type="submit">Send</button>
			</form>
		</main>
	}
}
