package templates

import (
	"strconv"
	"strings"
	"time"

	kritui_db "seesharpsi/kritui/db"
	"seesharpsi/kritui/llm"
)

templ MessageList(messages []llm.Message) {
	<div class="message-list" aria-live="polite">
		<div id="messages" class="message-thread">
			@Messages(messages...)
		</div>
		if len(messages) == 0 {
			<p class="chat-empty">begin a convo...</p>
		}
	</div>
}

templ HistoryList(chatID string, chats []kritui_db.Chat) {
	<div class="message-list history-list">
		<style>
        .chat-options {
            display: none;
        }
    </style>
		if len(chats) == 0 {
			<p class="history-empty">No saved chats yet.</p>
		} else {
			<nav class="history-nav" aria-label="Chat history">
				<ul>
					for _, chat := range chats {
						<li>
							<a
								class={ "history-entry" , templ.KV("current", strconv.FormatInt(chat.ID, 10)==chatID) }
								href={ templ.URL("/?chat=" + strconv.FormatInt(chat.ID, 10)) }
							>
								<span class="history-meta">
									<strong>{ historyTitle(chat) }</strong>
									<time datetime={ chat.UpdatedAt }>{ historyTime(chat.UpdatedAt) }</time>
								</span>
								<button type="button"
									class="history-action history-delete"
									hx-delete={ deleteChatURL(chat.ID, chatID) }
									hx-target=".message-list"
									hx-swap="outerHTML"
									hx-confirm={ "Permanently delete " +
                    historyTitle(chat) + "?" }
									aria-label={ "Delete " + historyTitle(chat) }
									title={ "Delete " +
                    historyTitle(chat) }
								>
									<svg
										aria-hidden="true"
										viewBox="0 0 24 24"
										width="20"
										height="20"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<path d="M3 6h18"></path>
										<path d="M8 6V4h8v2"></path>
										<path d="M19 6l-1 14H6L5 6"></path>
										<path d="M10 11v5M14 11v5"></path>
									</svg>
								</button>
							</a>
						</li>
					}
				</ul>
			</nav>
		}
		<a class="history-action history-new" href="/" aria-label="Start a new chat" title="Start a new chat">+</a>
	</div>
	@HistoryButton(chatID, true, true)
}

templ ChatMessageList(chatID string, messages []llm.Message) {
	@MessageList(messages)
	@HistoryButton(chatID, false, true)
}

templ HistoryButton(chatID string, active bool, outOfBand bool) {
	<button
		id="history-button"
		type="button"
		class={ "history-button" , templ.KV("active", active) }
		hx-get={ historyToggleURL(chatID, active) }
		hx-target=".message-list"
		hx-swap={ historySwap(active) }
		aria-pressed={ strconv.FormatBool(active) }
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>History</button>
}

func historyToggleURL(chatID string, active bool) string {
	if active {
		return "/chat?chat=" + chatID
	}
	return "/history?chat=" + chatID
}

func historySwap(active bool) string {
	if active {
		return "outerHTML scroll:bottom"
	}
	return "outerHTML"
}

func deleteChatURL(chatID int64, currentChatID string) string {
	return "/chats/" + strconv.FormatInt(chatID, 10) + "?current=" + currentChatID
}

func historyTitle(chat kritui_db.Chat) string {
	if title := strings.TrimSpace(chat.Title); title != "" {
		return title
	}
	return "Chat " + strconv.FormatInt(chat.ID, 10)
}

func historyTime(value string) string {
	parsed, err := time.Parse(time.RFC3339Nano, value)
	if err != nil {
		return value
	}
	return parsed.Local().Format("Jan 2, 2006 at 3:04 PM")
}
