package templates

import (
	"net/url"
	"strconv"
	"strings"
	"time"

	kritui_db "seesharpsi/kritui/db"
	"seesharpsi/kritui/llm"
)

templ MessageList(chatID string, messages []llm.Message, outOfBand bool) {
	<div
		id="message-list"
		class="message-list"
		aria-live="polite"
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		<div id="messages" class="message-thread">
			<div id="message-history">
				@Messages(chatID, messages...)
			</div>
			{ children... }
		</div>
		if len(messages) == 0 {
			<div class="chat-empty">
				<p class="eyebrow">KRITUI</p>
				<h1>No messages yet</h1>
				<p class="empty-description">Type below to begin.<span class="empty-desktop-help">{ " History, settings stay on the bottom bar." }</span></p>
				<div class="empty-commands">
					<a href="/">/new</a>
					<button type="button" data-panel-target="history-page" aria-controls="history-page" aria-expanded="false">/history</button>
				</div>
				<span class="chat-empty-completion" aria-hidden="true"><span class="braille-spinner" aria-hidden="true"></span></span>
			</div>
		}
	</div>
}

templ HistoryPage(chatID string) {
	<section
		id="history-page"
		class="panel-page history-page"
		aria-label="Chat history"
		tabindex="-1"
		data-panel-initial-focus
		hx-get={ historyEntriesURL(chatID, "", 0, false) }
		hx-trigger="history-open"
		hx-target="#history-entries"
		hx-swap="innerHTML"
		hx-sync="this:replace"
		hidden
	>
		<header class="panel-heading">
			<p id="history-count" class="eyebrow">Browse</p>
		</header>
		<nav class="history-nav" aria-label="Chat history">
			<ul id="history-entries">
				@HistoryLoader(chatID, "", 0, false)
			</ul>
		</nav>
		@HistoryError("", false)
		<a class="history-action history-new" href="/" aria-label="Start a new chat" title="Start a new chat">+</a>
	</section>
}

templ HistoryLoadError(message string) {
	<li class="history-error" role="alert">{ message }</li>
}

templ HistoryError(message string, outOfBand bool) {
	<p
		id="history-error"
		class="history-status"
		role="alert"
		if message == "" {
			hidden
		}
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>{ message }</p>
}

templ HistoryRefresh(chatID string, chats []kritui_db.Chat, firstPage bool, hasMore bool, count int) {
	<hx-partial hx-target="#history-entries" hx-swap="innerHTML">
		@HistoryEntries(chatID, chats, firstPage, hasMore)
		@HistoryError("", true)
		@HistoryCount(count)
	</hx-partial>
}

// HistoryDeletion updates the history count after a row is deleted. It leaves
// surviving rows untouched so the loaded page and pagination cursor survive.
// The empty marker is inserted out of band because the main swap deletes the
// targeted row and the response carries no replacement content for it.
templ HistoryDeletion(count int) {
	if count == 0 {
		<div hx-swap-oob="innerHTML:#history-entries">
			<li class="history-empty">No saved chats yet.</li>
		</div>
	}
	@HistoryError("", true)
	@HistoryCount(count)
}

templ HistoryEntries(chatID string, chats []kritui_db.Chat, firstPage bool, hasMore bool) {
	if firstPage && len(chats) == 0 {
		<li class="history-empty">No saved chats yet.</li>
	}
	for _, chat := range chats {
		<li>
			@HistoryEntry(chatID, chat)
		</li>
	}
	if hasMore && len(chats) > 0 {
		@HistoryLoader(chatID, chats[len(chats)-1].UpdatedAt, chats[len(chats)-1].ID, chats[len(chats)-1].Pinned)
	}
}

templ HistoryLoader(chatID string, beforeUpdatedAt string, beforeID int64, beforePinned bool) {
	<li
		class="history-loader"
		if beforeUpdatedAt != "" {
			hx-get={ historyEntriesURL(chatID, beforeUpdatedAt, beforeID, beforePinned) }
			hx-trigger="intersect once root:#history-page threshold:0.1"
			hx-target="this"
			hx-swap="outerHTML"
			hx-sync="this:drop"
			hx-indicator="this"
			hx-vals={ `js:{limit: Math.min(50, Math.max(1, Math.ceil((this.closest('.history-page')?.clientHeight ?? 0) / 80)))}` }
		}
		aria-label="Loading chat history"
	>
		<span class="braille-spinner" aria-hidden="true"></span>
	</li>
}

templ HistoryEntry(chatID string, chat kritui_db.Chat) {
	<div
		class={ "history-entry", templ.KV("current", strconv.FormatInt(chat.ID, 10) == chatID), templ.KV("pinned", chat.Pinned) }
	>
		<span class="history-meta">
			<span class="history-title-slot">
				<a
					class="history-title-link"
					href={ templ.URL("/?chat=" + strconv.FormatInt(chat.ID, 10)) }
					hx-boost="true"
					hx-target="main"
					hx-select="main"
					hx-swap="outerHTML show:none"
					if strconv.FormatInt(chat.ID, 10) == chatID {
						aria-current="page"
					}
				>
					<strong>
						<span class="history-title-text">{ historyTitle(chat) }</span>
						<span class="history-title-spinner" role="status" aria-label="Generating chat title"><span class="braille-spinner" aria-hidden="true"></span></span>
					</strong>
				</a>
				<form
					id={ "history-rename-" + strconv.FormatInt(chat.ID, 10) }
					class="history-rename"
					hx-put={ chatURL(chat.ID, chatID) }
					hx-target="#history-entries"
					hx-swap="innerHTML"
				>
					<input
						type="text"
						name="title"
						value={ historyTitle(chat) }
						aria-label={ "Rename " + historyTitle(chat) }
						required
						autocomplete="off"
					/>
				</form>
			</span>
			<time datetime={ chat.UpdatedAt }>{ historyTime(chat.UpdatedAt) }</time>
		</span>
		<form
			class="history-pin-form"
			hx-put={ chatPinURL(chat.ID, chatID) }
			hx-target="#history-entries"
			hx-swap="innerHTML"
		>
			<input type="hidden" name="pinned" value={ pinToggleValue(chat.Pinned) }/>
			<button
				type="submit"
				class={ "history-action history-pin", templ.KV("pinned", chat.Pinned) }
				aria-label={ pinActionLabel(chat) }
				aria-pressed={ strconv.FormatBool(chat.Pinned) }
				title={ pinActionLabel(chat) }
			>
				@Icon("M12 17v5", "M9 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4h4a2 2 0 0 0 0 4 1 1 0 0 1 1 1v3.76a2 2 0 0 0 1.11 1.79l1.78.9A2 2 0 0 1 19 15.24V16a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-.76a2 2 0 0 1 1.11-1.79l1.78-.9A2 2 0 0 1 9 10.76Z")
			</button>
		</form>
		<button
			type="button"
			class="history-action history-edit"
			aria-label={ "Rename " + historyTitle(chat) }
			title={ "Rename " + historyTitle(chat) }
		>
			@Icon("M12 20h9", "M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z")
		</button>
		<button
			type="submit"
			class="history-save"
			form={ "history-rename-" + strconv.FormatInt(chat.ID, 10) }
			aria-label={ "Save rename for " + historyTitle(chat) }
			title="Save rename"
		>
			@Icon("M20 6 9 17l-5-5")
		</button>
		<button
			type="button"
			class="history-action history-cancel"
			aria-label="Cancel rename"
			title="Cancel rename"
		>
			@Icon("M18 6 6 18", "m6 6 12 12")
		</button>
		<button
			type="button"
			class="history-action history-delete"
			hx-delete={ chatURL(chat.ID, chatID) }
			hx-target="closest li"
			hx-swap="delete swapEmpty:true"
			hx-indicator="this"
			hx-confirm={ "Permanently delete " + historyTitle(chat) + "?" }
			aria-label={ "Delete " + historyTitle(chat) }
			title={ "Delete " + historyTitle(chat) }
		>
			@Icon("M3 6h18", "M8 6V4h8v2", "M19 6l-1 14H6L5 6", "M10 11v5M14 11v5")
			<span class="history-delete-spinner braille-spinner" aria-hidden="true"></span>
		</button>
	</div>
}

templ Icon(paths ...string) {
	<svg
		aria-hidden="true"
		viewBox="0 0 24 24"
		width="20"
		height="20"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		for _, path := range paths {
			<path d={ path }></path>
		}
	</svg>
}

templ HistoryButton() {
	<button
		id="history-button"
		type="button"
		class="history-button"
		data-panel-target="history-page"
		aria-controls="history-page"
		aria-label="History"
		title="History"
		aria-expanded="false"
	>
		History
	</button>
}

templ ChatSummary(title string, count int) {
	<span class="chat-summary-title">{ title }</span>
	<span class="chat-summary-count">{ " · " + countLabel(count, "message") }</span>
}

templ HistoryCount(count int) {
	<p id="history-count" class="eyebrow" hx-swap-oob="outerHTML">Browse · { countLabel(count, "chat") }</p>
	<span id="history-summary-count" hx-swap-oob="outerHTML">{ " · " + countLabel(count, "chat") }</span>
}

func countLabel(count int, noun string) string {
	if count != 1 {
		noun += "s"
	}
	return strconv.Itoa(count) + " " + noun
}

func historyEntriesURL(chatID, beforeUpdatedAt string, beforeID int64, beforePinned bool) string {
	query := url.Values{"chat": {chatID}}
	if beforeUpdatedAt != "" {
		query.Set("before", beforeUpdatedAt)
		query.Set("before_id", strconv.FormatInt(beforeID, 10))
		query.Set("before_pinned", historyPinnedValue(beforePinned))
	}
	return "/history?" + query.Encode()
}

func chatURL(chatID int64, currentChatID string) string {
	return "/chats/" + strconv.FormatInt(chatID, 10) + "?current=" + currentChatID
}

func chatPinURL(chatID int64, currentChatID string) string {
	return "/chats/" + strconv.FormatInt(chatID, 10) + "/pin?current=" + currentChatID
}

func pinToggleValue(pinned bool) string {
	if pinned {
		return "0"
	}
	return "1"
}

func historyPinnedValue(pinned bool) string {
	if pinned {
		return "1"
	}
	return "0"
}

func pinActionLabel(chat kritui_db.Chat) string {
	if chat.Pinned {
		return "Unpin " + historyTitle(chat)
	}
	return "Pin " + historyTitle(chat)
}

func historyTitle(chat kritui_db.Chat) string {
	if title := strings.TrimSpace(chat.Title); title != "" {
		return title
	}
	return "Chat " + strconv.FormatInt(chat.ID, 10)
}

func historyTime(value string) string {
	parsed, err := time.Parse(time.RFC3339Nano, value)
	if err != nil {
		return value
	}
	return parsed.Local().Format("Jan 2, 2006 at 3:04 PM")
}
