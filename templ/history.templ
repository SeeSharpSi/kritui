package templates

import (
	"net/url"
	"strconv"
	"strings"
	"time"

	kritui_db "seesharpsi/kritui/db"
	"seesharpsi/kritui/llm"
)

templ MessageList(messages []llm.Message, outOfBand bool) {
	<div
		id="message-list"
		class="message-list"
		aria-live="polite"
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		<div id="messages" class="message-thread">
			@Messages(messages...)
		</div>
		if len(messages) == 0 {
			<p class="chat-empty">begin a convo...</p>
		}
	</div>
}

templ HistoryPage(chatID string) {
	<section
		id="history-page"
		class="panel-page history-page"
		aria-labelledby="history-heading"
		hx-get={ historyEntriesURL(chatID, "", 0) }
		hx-trigger="history-open"
		hx-target="#history-entries"
		hx-swap="innerHTML"
		hx-sync="this:replace"
		hidden
	>
		<header class="panel-heading">
			<h1 id="history-heading" tabindex="-1" data-panel-initial-focus>Chat history</h1>
		</header>
		<nav class="history-nav" aria-label="Chat history">
			<ul id="history-entries">
				@HistoryLoader(chatID, "", 0)
			</ul>
		</nav>
		@HistoryError("", false)
		<a class="history-action history-new" href="/" aria-label="Start a new chat" title="Start a new chat">+</a>
	</section>
}

templ HistoryLoadError(message string) {
	<li class="history-error" role="alert">{ message }</li>
}

templ HistoryError(message string, outOfBand bool) {
	<p
		id="history-error"
		class="history-status"
		role="alert"
		if message == "" {
			hidden
		}
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>{ message }</p>
}

templ HistoryEntries(chatID string, chats []kritui_db.Chat, firstPage bool, hasMore bool) {
	if firstPage && len(chats) == 0 {
		<li class="history-empty">No saved chats yet.</li>
	}
	for _, chat := range chats {
		<li>
			@HistoryEntry(chatID, chat)
		</li>
	}
	if hasMore && len(chats) > 0 {
		@HistoryLoader(chatID, chats[len(chats)-1].UpdatedAt, chats[len(chats)-1].ID)
	}
}

templ HistoryLoader(chatID string, beforeUpdatedAt string, beforeID int64) {
	<li
		class="history-loader"
		if beforeUpdatedAt != "" {
			hx-get={ historyEntriesURL(chatID, beforeUpdatedAt, beforeID) }
			hx-trigger="intersect once root:#history-page threshold:0.1"
			hx-target="this"
			hx-swap="outerHTML"
			hx-sync="this:drop"
		}
		aria-label="Loading chat history"
	>
		<span class="braille-spinner" aria-hidden="true"></span>
	</li>
}

templ HistoryEntry(chatID string, chat kritui_db.Chat) {
	<div
		class={ "history-entry", templ.KV("current", strconv.FormatInt(chat.ID, 10) == chatID) }
	>
		<span class="history-meta">
			<span class="history-title-slot">
				<a
					class="history-title-link"
					href={ templ.URL("/?chat=" + strconv.FormatInt(chat.ID, 10)) }
					hx-boost="true"
					hx-target="main"
					hx-select="main"
					hx-swap="outerHTML show:none"
					if strconv.FormatInt(chat.ID, 10) == chatID {
						aria-current="page"
					}
				>
					<strong>{ historyTitle(chat) }</strong>
				</a>
				<form
					class="history-rename"
					hx-put={ chatURL(chat.ID, chatID) }
					hx-target="#history-entries"
					hx-swap="innerHTML"
				>
					<input
						type="text"
						name="title"
						value={ historyTitle(chat) }
						aria-label={ "Rename " + historyTitle(chat) }
						required
						autocomplete="off"
					/>
					<button type="submit" class="history-save">Save</button>
				</form>
			</span>
			<time datetime={ chat.UpdatedAt }>{ historyTime(chat.UpdatedAt) }</time>
		</span>
		<button
			type="button"
			class="history-action history-edit"
			aria-label={ "Rename " + historyTitle(chat) }
			title={ "Rename " + historyTitle(chat) }
		>
			@Icon("M12 20h9", "M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z")
		</button>
		<button
			type="button"
			class="history-action history-cancel"
			aria-label="Cancel rename"
			title="Cancel rename"
		>
			@Icon("M18 6 6 18", "m6 6 12 12")
		</button>
		<button
			type="button"
			class="history-action history-delete"
			hx-delete={ chatURL(chat.ID, chatID) }
			hx-target="#history-entries"
			hx-swap="innerHTML"
			hx-confirm={ "Permanently delete " + historyTitle(chat) + "?" }
			aria-label={ "Delete " + historyTitle(chat) }
			title={ "Delete " + historyTitle(chat) }
		>
			@Icon("M3 6h18", "M8 6V4h8v2", "M19 6l-1 14H6L5 6", "M10 11v5M14 11v5")
		</button>
	</div>
}

templ Icon(paths ...string) {
	<svg
		aria-hidden="true"
		viewBox="0 0 24 24"
		width="20"
		height="20"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		for _, path := range paths {
			<path d={ path }></path>
		}
	</svg>
}

templ HistoryButton() {
	<button
		id="history-button"
		type="button"
		class="history-button"
		data-panel-target="history-page"
		aria-controls="history-page"
		aria-expanded="false"
	>History</button>
}

func historyEntriesURL(chatID, beforeUpdatedAt string, beforeID int64) string {
	query := url.Values{"chat": {chatID}}
	if beforeUpdatedAt != "" {
		query.Set("before", beforeUpdatedAt)
		query.Set("before_id", strconv.FormatInt(beforeID, 10))
	}
	return "/history?" + query.Encode()
}

func chatURL(chatID int64, currentChatID string) string {
	return "/chats/" + strconv.FormatInt(chatID, 10) + "?current=" + currentChatID
}

func historyTitle(chat kritui_db.Chat) string {
	if title := strings.TrimSpace(chat.Title); title != "" {
		return title
	}
	return "Chat " + strconv.FormatInt(chat.ID, 10)
}

func historyTime(value string) string {
	parsed, err := time.Parse(time.RFC3339Nano, value)
	if err != nil {
		return value
	}
	return parsed.Local().Format("Jan 2, 2006 at 3:04 PM")
}
